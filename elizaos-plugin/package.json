{
  "name": "elizaos-plugin-pumpclaw",
  "version": "1.0.0",
  "description": "ElizaOS plugin for PumpClaw — free token launcher on Base (Uniswap V4). Deploy ERC-20 tokens with LP locked forever, 80% creator fees.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "elizaos",
    "plugin",
    "pumpclaw",
    "base",
    "token-launcher",
    "uniswap-v4",
    "ai-agent",
    "erc20",
    "defi"
  ],
  "author": "clawd800",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clawd800/pumpclaw"
  },
  "homepage": "https://pumpclaw.com",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^25.2.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "prepublishOnly": "npm run build"
  }
}
